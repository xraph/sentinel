package pages

import (
	"encoding/json"

	"github.com/xraph/sentinel/dashboard/components"
	"github.com/xraph/sentinel/testcase"
	"github.com/xraph/forgeui/components/badge"
	"github.com/xraph/forgeui/components/button"
	"github.com/xraph/forgeui/components/card"
)

templ CaseDetailPage(tc *testcase.Case) {
	<div class="space-y-6">
		@components.PageHeader(tc.Name, "", "Test case detail") {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Attributes: templ.Attributes{
					"hx-get":    "/suites/cases/edit?id=" + tc.ID.String() + "&suite_id=" + tc.SuiteID.String(),
					"hx-target": "#content",
				},
			}) {
				Edit
			}
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Attributes: templ.Attributes{
					"hx-get":    "/suites/cases?suite_id=" + tc.SuiteID.String(),
					"hx-target": "#content",
				},
			}) {
				Back
			}
		}
		<div class="grid gap-6 lg:grid-cols-2">
			@card.Card() {
				@card.Header() {
					@card.Title() { Configuration }
				}
				@card.Content() {
					<div class="space-y-3 text-sm">
						<div class="flex justify-between">
							<span class="text-muted-foreground">Scenario Type</span>
							<span>
								@components.ScenarioTypeBadge(string(tc.ScenarioType))
							</span>
						</div>
						<div class="flex justify-between">
							<span class="text-muted-foreground">Suite ID</span>
							<code class="text-xs bg-muted px-1 py-0.5 rounded">{ tc.SuiteID.String() }</code>
						</div>
						<div class="flex justify-between">
							<span class="text-muted-foreground">Case ID</span>
							<code class="text-xs bg-muted px-1 py-0.5 rounded">{ tc.ID.String() }</code>
						</div>
						if len(tc.Tags) > 0 {
							<div>
								<span class="text-muted-foreground">Tags</span>
								<div class="flex gap-1 flex-wrap mt-1">
									for _, tag := range tc.Tags {
										@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
											{ tag }
										}
									}
								</div>
							</div>
						}
					</div>
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() { Scorers }
				}
				@card.Content() {
					if len(tc.Scorers) == 0 {
						<span class="text-sm text-muted-foreground">No scorers configured (suite defaults apply)</span>
					} else {
						<div class="space-y-2">
							for _, sc := range tc.Scorers {
								<div class="bg-muted rounded-md p-3">
									<span class="text-sm font-medium">{ sc.Name }</span>
									if len(sc.Config) > 0 {
										{{ cfgBytes, _ := json.MarshalIndent(sc.Config, "", "  ") }}
										<pre class="text-xs font-mono mt-1">{ string(cfgBytes) }</pre>
									}
								</div>
							}
						</div>
					}
				}
			}
		</div>
		@card.Card() {
			@card.Header() {
				@card.Title() { Input }
			}
			@card.Content() {
				<pre class="bg-muted rounded-md p-3 text-sm font-mono overflow-x-auto whitespace-pre-wrap">{ tc.Input }</pre>
			}
		}
		if tc.Expected != "" {
			@card.Card() {
				@card.Header() {
					@card.Title() { Expected Output }
				}
				@card.Content() {
					<pre class="bg-muted rounded-md p-3 text-sm font-mono overflow-x-auto whitespace-pre-wrap">{ tc.Expected }</pre>
				}
			}
		}
		if len(tc.Context) > 0 {
			@card.Card() {
				@card.Header() {
					@card.Title() { Context }
				}
				@card.Content() {
					@components.JsonViewer(tc.Context)
				}
			}
		}
		if len(tc.Metadata) > 0 {
			@card.Card() {
				@card.Header() {
					@card.Title() { Metadata }
				}
				@card.Content() {
					@components.JsonViewer(tc.Metadata)
				}
			}
		}
	</div>
}
