package pages

import (
	"fmt"

	"github.com/xraph/forgeui/components/badge"
	"github.com/xraph/forgeui/components/button"
	"github.com/xraph/forgeui/components/card"
	"github.com/xraph/forgeui/components/table"
	"github.com/xraph/sentinel/baseline"
	"github.com/xraph/sentinel/dashboard/components"
)

templ BaselineDetailPage(b *baseline.Baseline, suiteName string) {
	<div class="space-y-6">
		@components.PageHeader(b.Name, "", "Baseline for suite: "+suiteName) {
			<div class="flex gap-2">
				@components.CurrentBadge(b.IsCurrent)
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Attributes: templ.Attributes{
						"hx-get":    "?page=baselines",
						"hx-target": "#content",
						"hx-swap":   "innerHTML",
					},
				}) {
					Back
				}
			</div>
		}
		<!-- Summary Stats -->
		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			@components.StatCard("Pass Rate", fmt.Sprintf("%.1f%%", b.PassRate*100), "Overall pass rate", "check-circle")
			@components.StatCard("Avg Score", fmt.Sprintf("%.3f", b.AvgScore), "Average score across cases", "bar-chart-2")
			@components.StatCard("Cases", fmt.Sprintf("%d", len(b.Results)), "Total cases in baseline", "file-text")
			@components.StatCard("Run ID", b.RunID.String(), "Source evaluation run", "play")
		</div>
		<!-- Dimension Scores -->
		if len(b.DimensionScores) > 0 {
			@card.Card(card.Props{}) {
				@card.Header() {
					@card.Title() { Dimension Scores }
				}
				@card.Content() {
					<div class="space-y-3">
						for dim, score := range b.DimensionScores {
							<div class="flex items-center justify-between">
								<span class="text-sm font-medium">{ dim }</span>
								<div class="flex items-center gap-2">
									@components.ScoreBar(score)
									<span class="text-sm text-muted-foreground w-14 text-right">{ fmt.Sprintf("%.3f", score) }</span>
								</div>
							</div>
						}
					</div>
				}
			}
		}
		<!-- Per-Case Results -->
		@card.Card(card.Props{}) {
			@card.Header() {
				@card.Title() { Per-Case Results }
				@card.Description() { Baseline results for each test case }
			}
			@card.Content() {
				if len(b.Results) == 0 {
					@components.EmptyState("file-text", "No results", "This baseline has no per-case results.")
				} else {
					@table.Table(table.Props{}) {
						@table.Header() {
							@table.Row() {
								@table.Head() { Case Name }
								@table.Head() { Status }
								@table.Head() { Score }
								if baselineHasDimensions(b) {
									@table.Head() { Dimensions }
								}
							}
						}
						@table.Body() {
							for _, r := range b.Results {
								@table.Row() {
									@table.Cell() {
										<span class="font-medium">{ r.CaseName }</span>
									}
									@table.Cell() {
										@baselineStatusBadge(r.Status)
									}
									@table.Cell() {
										@components.ScoreBar(r.Score)
									}
									if baselineHasDimensions(b) {
										@table.Cell() {
											if len(r.DimensionScores) > 0 {
												<div class="flex flex-wrap gap-1">
													for dim, score := range r.DimensionScores {
														@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
															{ fmt.Sprintf("%s: %.2f", dim, score) }
														}
													}
												</div>
											} else {
												<span class="text-muted-foreground">-</span>
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
		<!-- Info -->
		@card.Card(card.Props{}) {
			@card.Header() {
				@card.Title() { Details }
			}
			@card.Content() {
				<div class="grid grid-cols-2 gap-4 text-sm">
					<div>
						<span class="text-muted-foreground">Baseline ID</span>
						<p class="font-mono text-xs mt-1">{ b.ID.String() }</p>
					</div>
					<div>
						<span class="text-muted-foreground">Suite ID</span>
						<p class="font-mono text-xs mt-1">{ b.SuiteID.String() }</p>
					</div>
					<div>
						<span class="text-muted-foreground">Run ID</span>
						<p class="font-mono text-xs mt-1">{ b.RunID.String() }</p>
					</div>
					<div>
						<span class="text-muted-foreground">Created</span>
						<p class="mt-1">{ b.CreatedAt.Format("Jan 2, 2006 15:04:05") }</p>
					</div>
				</div>
			}
		}
	</div>
}

func baselineHasDimensions(b *baseline.Baseline) bool {
	for _, r := range b.Results {
		if len(r.DimensionScores) > 0 {
			return true
		}
	}
	return false
}

templ baselineStatusBadge(status string) {
	switch status {
		case "pass":
			@badge.Badge(badge.Props{Variant: badge.VariantDefault}) {
				Pass
			}
		case "fail":
			@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
				Fail
			}
		default:
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				{ status }
			}
	}
}
