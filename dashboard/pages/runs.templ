package pages

import (
	"fmt"

	"github.com/xraph/sentinel/dashboard/components"
	"github.com/xraph/sentinel/dashboard/shared"
	"github.com/xraph/sentinel/evalrun"
	"github.com/xraph/sentinel/suite"
	"github.com/xraph/forgeui/components/button"
	"github.com/xraph/forgeui/components/table"
)

templ RunsPage(items []*evalrun.Run, stateFilter string, suiteFilter string, suites []*suite.Suite, suiteNames map[string]string, pg shared.PaginationMeta) {
	<div class="space-y-6">
		@components.PageHeader("Evaluation Runs", fmt.Sprintf("%d", pg.Total), "View and manage evaluation runs")
		<div class="flex gap-4 flex-wrap">
			<select name="state" class="flex h-10 rounded-md border border-input bg-background px-3 py-2 text-sm"
				hx-get="/runs"
				hx-target="#content"
				hx-trigger="change"
				hx-include="[name='suite']"
				hx-push-url="true">
				<option value="" selected?={ stateFilter == "" }>All States</option>
				<option value="running" selected?={ stateFilter == "running" }>Running</option>
				<option value="completed" selected?={ stateFilter == "completed" }>Completed</option>
				<option value="failed" selected?={ stateFilter == "failed" }>Failed</option>
				<option value="cancelled" selected?={ stateFilter == "cancelled" }>Cancelled</option>
			</select>
			<select name="suite" class="flex h-10 rounded-md border border-input bg-background px-3 py-2 text-sm"
				hx-get="/runs"
				hx-target="#content"
				hx-trigger="change"
				hx-include="[name='state']"
				hx-push-url="true">
				<option value="" selected?={ suiteFilter == "" }>All Suites</option>
				for _, s := range suites {
					<option value={ s.ID.String() } selected?={ suiteFilter == s.ID.String() }>{ s.Name }</option>
				}
			</select>
		</div>
		if len(items) == 0 {
			@components.EmptyState("play", "No runs yet", "Run an evaluation from a suite to see results here.")
		} else {
			@table.Table() {
				@table.Header() {
					@table.Row() {
						@table.Head() { Suite }
						@table.Head() { Model }
						@table.Head() { State }
						@table.Head() { Pass Rate }
						@table.Head() { Avg Score }
						@table.Head() { Cases }
						@table.Head() { Tokens }
						@table.Head() { Created }
						@table.Head() { Actions }
					}
				}
				@table.Body() {
					for _, r := range items {
						{{ sName := runsLookupSuite(r.SuiteID.String(), suiteNames) }}
						@table.Row() {
							@table.Cell() {
								<a class="text-sm font-medium hover:underline cursor-pointer"
									hx-get={ "/suites/detail?id=" + r.SuiteID.String() }
									hx-target="#content">
									{ sName }
								</a>
							}
							@table.Cell() {
								<span class="text-sm">{ r.Model }</span>
							}
							@table.Cell() {
								@components.RunStateBadge(string(r.State))
							}
							@table.Cell() {
								@components.ScoreBar(r.PassRate)
							}
							@table.Cell() {
								<span class="text-sm">{ fmt.Sprintf("%.2f", r.AvgScore) }</span>
							}
							@table.Cell() {
								<span class="text-sm">{ fmt.Sprintf("%d/%d", r.Passed, r.TotalCases) }</span>
							}
							@table.Cell() {
								<span class="text-xs text-muted-foreground">{ fmt.Sprintf("%d", r.TotalTokens) }</span>
							}
							@table.Cell() {
								{{ created := r.CreatedAt.Format("Jan 02 15:04") }}
								<span class="text-xs text-muted-foreground">{ created }</span>
							}
							@table.Cell() {
								<div class="flex gap-1">
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Attributes: templ.Attributes{
											"hx-get":    "/runs/detail?id=" + r.ID.String(),
											"hx-target": "#content",
										},
									}) {
										View
									}
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Attributes: templ.Attributes{
											"hx-get":    "/runs/report?id=" + r.ID.String(),
											"hx-target": "#content",
										},
									}) {
										Report
									}
								</div>
							}
						}
					}
				}
			}
			@Pagination(pg, fmt.Sprintf("/runs?state=%s&suite=%s", stateFilter, suiteFilter))
		}
	</div>
}

func runsLookupSuite(suiteIDStr string, nameMap map[string]string) string {
	if name, ok := nameMap[suiteIDStr]; ok {
		return name
	}
	if len(suiteIDStr) > 12 {
		return suiteIDStr[:12] + "..."
	}
	return suiteIDStr
}
